# ローカル開発用 SQLite（TURSO_DATABASE_URL が未設定の場合に使用）
DATABASE_URL="file:./prisma/dev.db"

# Turso（本番環境）
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-auth-token

# Session secret (32文字以上の任意の文字列)
SESSION_SECRET="your-secret-key-here"

# Seed script用 (npx tsx prisma/seed.ts 実行時のみ使用)
SEED_EMAIL="admin@example.com"
SEED_USERNAME="your-username"
SEED_PASSWORD="your-password"

# Google Books API key (任意 - なくても動作します)
# GOOGLE_BOOKS_API_KEY=your_key_here
